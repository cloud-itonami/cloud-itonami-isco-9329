;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a material-handling robot may perform component
;; staging, line-side replenishment or debris clearing for manufacturing
;; labourers (ISCO 9329); the actor itself only proposes coordination records.
;; The robot's physical work declared here: a tugger train pulling component
;; carts from the supermarket to the line, and an arm staging component bins
;; onto the line-side flow rack at the line's takt.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-9329"
 :cases
 [{:id :tugger-line-replenishment
   :kind :transport
   :procedure "tugger AMR pulls a train of component carts 150 m from the supermarket to the assembly line"
   :params {:mass-kg 350.0 :payload-kg 1000.0 :distance-m 150.0 :v-max-mps 1.5 :a-max-mps2 0.3
            :brake-decel-mps2 0.6 :drive-force-n 1200.0 :crr 0.015
            :cog-height-m 0.40 :support-half-length-m 0.40 :max-time-s 1800.0}
   :sweep {:param :payload-kg :values [500.0 1000.0 2000.0 4000.0 6000.0 7500.0]}
   :quantity :cycle-time-s
   :limit {:max 130.0 :basis "estimate: one replenishment leg within a 20-minute milk-run loop with several stops"}
   :boundary {:lo 100.0 :hi 8000.0}}
  {:id :bin-to-flow-rack
   :kind :manipulator
   :procedure "arm moves an 8 kg component bin from the cart onto the line-side flow rack, move time varied with the line takt"
   :params {:l1-m 0.55 :l2-m 0.45 :m1-kg 6.0 :m2-kg 4.0 :payload-kg 8.0
            :from [0.65 0.05] :to [0.25 0.75] :steps 500}
   :sweep {:param :duration-s :values [0.8 1.0 1.5 2.0 3.0]}
   :quantity :peak-tau1-nm
   :limit {:max 150.0 :basis "estimate: peak shoulder torque of a ~10 kg-payload handling arm"}
   :boundary {:lo 0.4 :hi 4.0}}]}
